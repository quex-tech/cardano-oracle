# Copy to ../.env (off-chain/.env, which is gitignored) and fill in.
# The only secret here is WALLET_MNEMONIC. No oracle/TEE keys live on this machine.

CARDANO_NETWORK=mainnet

# Requester wallet. Generate with: ./wallet.py generate --passphrase <pass>
# Top up its Treasury address with ~3-5 ADA before recording.
WALLET_MNEMONIC="word word word word ... (24 words)"
# PASSPHRASE=            # only if you generated the wallet with a passphrase

# Cardano access: a blockfrost.io mainnet project id, or leave empty for local Ogmios.
BLOCKFROST_PROJECT=mainnet_XXXXXXXXXXXXXXXX

# Mainnet oracle pool to request from (hex).
ORACLE_POOL_ID=

# Optional, only for the manual-fulfill fallback in 03 (needs signer network access).
# ORACLE_URL=http://10.13.192.131:8080

# Optional: confirmed spend tx for Act 3 (04-consumer.sh prints its explorer link).
# SPEND_TX=
