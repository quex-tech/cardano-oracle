cabal-version:   3.0
name:            quex-oracle
version:         0.1.0.0
license:         Apache-2.0
license-file:    LICENSE
build-type:      Simple

common options
  ghc-options: -Wall
  default-language: Haskell2010

library scripts
  import:         options
  hs-source-dirs: src
  exposed-modules:
    ExampleUserValidator
    SingleOraclePoolValidator
    OracleResponseValidator
    OracleRequestValidator
    Validator

  build-depends:
    , base
    , plutus-core ^>=1.42.0.0
    , plutus-ledger-api ^>=1.42.0.0
    , plutus-tx ^>=1.42.0.0

  if !(impl(ghcjs) || os(ghcjs))
    build-depends: plutus-tx-plugin

executable gen-oracle-blueprint
  import:           options
  hs-source-dirs:   app
  main-is:          GenOracleBlueprint.hs
  build-depends:
    , base
    , bytestring
    , containers
    , plutus-core ^>=1.42.0.0
    , plutus-ledger-api ^>=1.42.0.0
    , plutus-tx ^>=1.42.0.0
    , plutus-tx-plugin ^>=1.42.0.0
    , scripts

executable gen-example-user-blueprint
  import:           options
  hs-source-dirs:   app
  main-is:          GenExampleUserBlueprint.hs
  build-depends:
    , base
    , bytestring
    , containers
    , plutus-core ^>=1.42.0.0
    , plutus-ledger-api ^>=1.42.0.0
    , plutus-tx ^>=1.42.0.0
    , plutus-tx-plugin ^>=1.42.0.0
    , scripts
    , text

test-suite quex-oracle-test
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Main.hs
  build-depends:
    , base
    , plutus-core ^>=1.42.0.0
    , plutus-ledger-api ^>=1.42.0.0
    , plutus-tx ^>=1.42.0.0
    , HUnit ^>=1.6
    , scripts
  default-language:    Haskell2010